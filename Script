-- === Persistent File Storage ===
local SAVE_FILE_NAME = "AnimOverride_CustomSaves.json"
local saveData = {
    customSaves = {},
    maxWalkSpeedLimit = 100,
    minWalkSpeedLimit = 1,
    maxAnimSpeedLimit = 5.0,
    minAnimSpeedLimit = 0.1
}

local function loadSavesFromFile()
    pcall(function()
        if readfile and isfile and isfile(SAVE_FILE_NAME) then
            local content = readfile(SAVE_FILE_NAME)
            local decoded = HttpService:JSONDecode(content)
            if type(decoded) == "table" then
                if decoded.customSaves then
                    saveData.customSaves = decoded.customSaves
                else
                    saveData.customSaves = decoded
                end
                if decoded.maxWalkSpeedLimit then maxWalkSpeedLimit = decoded.maxWalkSpeedLimit end
                if decoded.minWalkSpeedLimit then minWalkSpeedLimit = decoded.minWalkSpeedLimit end
                if decoded.maxAnimSpeedLimit then maxAnimSpeedLimit = decoded.maxAnimSpeedLimit end
                if decoded.minAnimSpeedLimit then minAnimSpeedLimit = decoded.minAnimSpeedLimit end
            end
        end
    end)
end

local function saveSavesToFile()
    pcall(function()
        if writefile then
            saveData.maxWalkSpeedLimit = maxWalkSpeedLimit
            saveData.minWalkSpeedLimit = minWalkSpeedLimit
            saveData.maxAnimSpeedLimit = maxAnimSpeedLimit
            saveData.minAnimSpeedLimit = minAnimSpeedLimit
            writefile(SAVE_FILE_NAME, HttpService:JSONEncode(saveData))
        end
    end)
end

