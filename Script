    label.TextSize = customUiConfig.textSize
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = sliderContainer
    table.insert(managedTextObjects, label)

    local function formatLabelText(value, isResetState)
        if labelText == "Animation Speed"
            and value == 1
            and isResetState then
            return labelText .. ": Default"
        end

        if labelText == "WalkSpeed"
            and (not isWalkSpeedActive or isResetState) then
            return labelText .. ": Default"
        end

        return labelText .. ": " .. tostring(value)
    end

    label.Text = formatLabelText(
        defaultVal,
        labelText == "WalkSpeed" or labelText == "Animation Speed"
    )

    label.MouseButton1Click:Connect(function()
        openSpeedModal(labelText)
    end)

    local resetBtn = Instance.new("TextButton")
    resetBtn.Name = labelText .. "Reset"
    resetBtn.Size = UDim2.fromOffset(50, 18)
    resetBtn.Position = UDim2.fromOffset(180, yPos)
    resetBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    resetBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    resetBtn.Font = Enum.Font.SourceSansSemibold
    resetBtn.TextSize = math.max(10, customUiConfig.textSize - 2)
    resetBtn.Text = "Reset"
    resetBtn.Parent = sliderContainer
    table.insert(managedTextObjects, resetBtn)

    local resetCorner = Instance.new("UICorner")
    resetCorner.CornerRadius = UDim.new(0, 4)
    resetCorner.Parent = resetBtn

    local bar = Instance.new("Frame")
    bar.Name = labelText .. "Bar"
    bar.Size = UDim2.fromOffset(230, 8)
    bar.Position = UDim2.fromOffset(0, yPos + 22)
    bar.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    bar.BorderSizePixel = 0
    bar.Parent = sliderContainer

    local barCorner = Instance.new("UICorner")
    barCorner.CornerRadius = UDim.new(1, 0)
    barCorner.Parent = bar

    local fill = Instance.new("Frame")
    fill.Name = "Fill"
    fill.BackgroundColor3 = Color3.fromRGB(255, 200, 60)
    fill.BorderSizePixel = 0
    fill.Parent = bar

    local fillCorner = Instance.new("UICorner")
    fillCorner.CornerRadius = UDim.new(1, 0)
    fillCorner.Parent = fill

    local sliderButton = Instance.new("TextButton")
    sliderButton.Name = "SliderButton"
    sliderButton.Size = UDim2.fromScale(1, 1)
    sliderButton.BackgroundTransparency = 1
    sliderButton.Text = ""
    sliderButton.AutoButtonColor = false
    sliderButton.Parent = bar

    local holdTimer
    local currentValHolder = defaultVal
    local isPrecisionActive = false
    local localDragging = false
    local pressPos = Vector2.zero
    local wasPreviouslyMinimized = false
    local isHovered = false

    local updateValue

    local function cancelHold()
        if holdTimer then
            task.cancel(holdTimer)
            holdTimer = nil
        end
    end

    updateValue = function(value, isReset)
        local currentMin = tonumber(getMinLimit()) or 0
        local currentMax = tonumber(getMaxLimit()) or currentMin

        currentMax = math.max(currentMin, currentMax)

        value = tonumber(value) or currentValHolder
        value = math.clamp(value, currentMin, currentMax)

        if not isPrecisionActive then
            if currentMax > 100 then
                value = math.round(value)
            elseif currentMax <= 10 then
                value = math.floor(value * 100 + 0.5) / 100
            else
                value = math.floor(value * 10 + 0.5) / 10
            end
        elseif currentMax > 10 then
            value = math.floor(value * 10) / 10
        else
            value = math.floor(value * 100) / 100
        end

        value = math.clamp(value, currentMin, currentMax)
        currentValHolder = value

        local range = math.max(currentMax - currentMin, 0.001)
        local ratio = math.clamp(
            (value - currentMin) / range,
            0,
            1
        )

        fill.Size = UDim2.new(ratio, 0, 1, 0)
        label.Text = formatLabelText(value, isReset)

        callback(value, isReset)

        if isPrecisionActive and precisionOverlay.Visible then
            precisionTitle.Text = string.format(
                "%s (Precision): %.2f",
                labelText,
                value
            )

            screenFill.Size = UDim2.new(ratio, 0, 1, 0)
        end
    end

    if labelText == "WalkSpeed" then
        updateWalkSpeedSlider = function(newValue, isReset)
            updateValue(newValue, isReset == true)
        end
    elseif labelText == "Animation Speed" then
        updateAnimSpeedSlider = function(newValue, isReset)
            updateValue(newValue, isReset == true)
        end
    end

    bar.MouseEnter:Connect(function()
        isHovered = true
    end)

    bar.MouseLeave:Connect(function()
        isHovered = false
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not isHovered then
            return
        end

        if input.UserInputType ~= Enum.UserInputType.MouseWheel then
            return
        end

        local wheelDelta = input.Position.Z

        if wheelDelta == 0 then
            return
        end

        local newValue = currentValHolder + (wheelDelta > 0 and 1 or -1)

        if labelText == "WalkSpeed" then
            isWalkSpeedActive = true
        end

        updateValue(newValue, false)
    end)

    resetBtn.MouseButton1Click:Connect(function()
        cancelHold()

        if isPrecisionActive then
            isPrecisionActive = false
            precisionOverlay.Visible = false

            if not wasPreviouslyMinimized then
                setSpeedMinimized(false)
            end
        end

        if labelText == "WalkSpeed" then
            isWalkSpeedActive = false
            currentWalkSpeed = originalWalkSpeed
            updateValue(originalWalkSpeed, true)
        else
            currentAnimMultiplier = 1
            updateValue(1, true)
        end
    end)

    sliderButton.MouseButton1Down:Connect(function()
        localDragging = true
        cancelHold()

        pressPos = UserInputService:GetMouseLocation()

        holdTimer = task.delay(1, function()
            if not localDragging then
                return
            end

            local currentPos = UserInputService:GetMouseLocation()

            if (currentPos - pressPos).Magnitude < 5 then
                isPrecisionActive = true
                activePrecisionCallback = updateValue
                activePrecisionMaxGetter = getMaxLimit
                activePrecisionMinGetter = getMinLimit

                wasPreviouslyMinimized = isSpeedMinimized

                if not isSpeedMinimized then
                    setSpeedMinimized(true)
                end

                precisionTitle.Text = string.format(
                    "%s (Precision): %.2f",
                    labelText,
                    currentValHolder
                )

                local precisionMin = getMinLimit()
                local precisionMax = getMaxLimit()
                local precisionRange = math.max(
                    precisionMax - precisionMin,
                    0.001
                )

                local ratio = math.clamp(
                    (currentValHolder - precisionMin) / precisionRange,
                    0,
                    1
                )

                screenFill.Size = UDim2.new(ratio, 0, 1, 0)
                precisionOverlay.Visible = true
            end
        end)
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
            return
        end

        localDragging = false
        cancelHold()

        if isPrecisionActive then
            isPrecisionActive = false
            precisionOverlay.Visible = false

            if not wasPreviouslyMinimized then
                setSpeedMinimized(false)
            end
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not localDragging then
            return
        end

        if input.UserInputType ~= Enum.UserInputType.MouseMovement then
            return
        end

        local currentPos = UserInputService:GetMouseLocation()

        if not isPrecisionActive
            and (currentPos - pressPos).Magnitude > 5 then
            cancelHold()
        end

        if isPrecisionActive then
            return
        end

        local barPosition = bar.AbsolutePosition.X
        local barWidth = bar.AbsoluteSize.X

        if barWidth <= 0 then
            return
        end

        local ratio = math.clamp(
            (currentPos.X - barPosition) / barWidth,
            0,
            1
        )

        local currentMin = getMinLimit()
        local currentMax = getMaxLimit()
        local value = currentMin + ratio * (currentMax - currentMin)

        if labelText == "WalkSpeed" then
            isWalkSpeedActive = true
        end

        updateValue(value, false)
    end)
end

-- Full-screen precision dragging support
UserInputService.InputChanged:Connect(function(input)
    if precisionOverlay.Visible and input.UserInputType == Enum.UserInputType.MouseMovement then
        local mousePos = UserInputService:GetMouseLocation().X
        local barPos = screenBar.AbsolutePosition.X
