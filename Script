local function createSlider(yPos, labelText, defaultVal, callback, getMinLimit, getMaxLimit)
	local label = Instance.new("TextButton")
	label.Name = labelText .. "Label"
	label.Size = UDim2.fromOffset(170, 18)
	label.Position = UDim2.fromOffset(0, yPos)
	label.BackgroundTransparency = 1
	label.TextColor3 = customUiConfig.textColor
	label.Font = Enum.Font.GothamBold
	label.TextSize = customUiConfig.textSize
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = sliderContainerParent
	table.insert(managedTextObjects, label)

	local function formatLabelText(value, isResetState)
		if labelText == "WalkSpeed" and (not isWalkSpeedActive or isResetState) then 
			return labelText .. ": Default" 
		end
		if labelText == "Animation Speed" and (not isAnimSpeedActive or isResetState) then 
			return labelText .. ": Default" 
		end
		return labelText .. ": " .. string.format("%.1f", value)
	end

	label.Text = formatLabelText(defaultVal, labelText == "WalkSpeed")

	label.MouseButton1Click:Connect(function()
		openLimitModal(labelText)
	end)

	local resetBtn = Instance.new("TextButton")
	resetBtn.Name = labelText .. "Reset"
	resetBtn.Size = UDim2.fromOffset(50, 18)
	resetBtn.Position = UDim2.fromOffset(180, yPos)
	resetBtn.BackgroundColor3 = customUiConfig.textBgColor
	resetBtn.TextColor3 = customUiConfig.textColor
	resetBtn.Font = Enum.Font.GothamSemibold
	resetBtn.TextSize = math.max(10, customUiConfig.textSize - 2)
	resetBtn.Text = "Reset"
	resetBtn.Parent = sliderContainerParent
	table.insert(managedTextObjects, resetBtn)
	table.insert(managedInteractiveButtons, resetBtn)
	local resetCorner = Instance.new("UICorner", resetBtn)
	resetCorner.CornerRadius = UDim.new(0, 6)
	addProfessionalStroke(resetBtn)

	local bar = Instance.new("Frame")
	bar.Name = labelText .. "Bar"
	bar.Size = UDim2.fromOffset(230, 8)
	bar.Position = UDim2.fromOffset(0, yPos + 22)
	bar.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
	bar.BorderSizePixel = 0
	bar.Parent = sliderContainerParent

	local barCorner = Instance.new("UICorner", bar)
	barCorner.CornerRadius = UDim.new(1, 0)
	addProfessionalStroke(bar)

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.new(0, 0, 1, 0)
	fill.BackgroundColor3 = customUiConfig.sliderColor
	fill.BorderSizePixel = 0
	fill.Parent = bar
	table.insert(managedSliders, fill)

	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(1, 0)
	fillCorner.Parent = fill

	local sliderButton = Instance.new("TextButton")
	sliderButton.Name = "SliderButton"
	sliderButton.Size = UDim2.fromScale(1, 1)
	sliderButton.BackgroundTransparency = 1
	sliderButton.Text = ""
	sliderButton.AutoButtonColor = false
	sliderButton.Parent = bar

	local currentValHolder = defaultVal
	local localDragging = false

	local function updateValue(value, isReset)
		local currentMin = tonumber(getMinLimit()) or 0
		local currentMax = tonumber(getMaxLimit()) or currentMin
		currentMax = math.max(currentMin, currentMax)
		value = tonumber(value) or currentValHolder
		value = math.clamp(math.round(value * 10) / 10, currentMin, currentMax)
		currentValHolder = value

		local range = math.max(currentMax - currentMin, 0.001)
		local ratio = math.clamp((value - currentMin) / range, 0, 1)

		fill.Size = UDim2.new(ratio, 0, 1, 0)
		label.Text = formatLabelText(value, isReset)
		callback(value, isReset)
	end

	if labelText == "WalkSpeed" then
		updateWalkSpeedSlider = updateValue
	else
		updateAnimSpeedSlider = updateValue
	end

	resetBtn.MouseButton1Click:Connect(function()
		if labelText == "WalkSpeed" then
			isWalkSpeedActive = false
			currentWalkSpeed = 16

			if humanoid and humanoid.Parent then
				pcall(function()
					humanoid.WalkSpeed = 16
				end)
			end
			updateValue(16, true)
		else
			isAnimSpeedActive = false
			currentAnimMultiplier = 1.0
			updateValue(1.0, true)
		end
	end)

	local holdTimer = nil
	local initialMousePos = Vector2.zero
	local isHolding = false

	local function activateBigSlider()
		setSpeedMinimized(true)
		bigSliderTitle.Text = labelText .. " (Editing): " .. string.format("%.1f", currentValHolder)
		bigSliderOverlay.Visible = true
		cursorSpeedLabel.Visible = true

		local curMin = tonumber(getMinLimit()) or 0
		local curMax = tonumber(getMaxLimit()) or curMin
		curMax = math.max(curMin, curMax)
		local ratio = math.clamp((currentValHolder - curMin) / math.max(curMax - curMin, 0.001), 0, 1)

		bigSliderFill.Size = UDim2.new(ratio, 0, 1, 0)
		cursorSpeedLabel.Text = string.format("%.1f", currentValHolder)

		task.defer(function()
			local absPos = bigSliderBar.AbsolutePosition
			local absSize = bigSliderBar.AbsoluteSize
			if absSize.X > 0 then
				local targetX = absPos.X + (ratio * absSize.X)
				local targetY = absPos.Y + (absSize.Y / 2)
				pcall(function()
					mousemoveabs(targetX, targetY)
				end)
			end
		end)

		local bigDragging = true
		local function updateBigVal(inputObj)
			local pointerX = inputObj.Position.X
			local barPos = bigSliderBar.AbsolutePosition.X
			local barSize = bigSliderBar.AbsoluteSize.X
			if barSize <= 0 then return end

			local r = math.clamp((pointerX - barPos) / barSize, 0, 1)
			local val = curMin + r * (curMax - curMin)
			if labelText == "WalkSpeed" then 
				isWalkSpeedActive = true 
			else
				isAnimSpeedActive = true
			end
			updateValue(val, false)
			bigSliderFill.Size = UDim2.new(r, 0, 1, 0)

			bigSliderTitle.Text = labelText .. " (Editing): " .. string.format("%.1f", val)
			cursorSpeedLabel.Text = string.format("%.1f", val)
			local mouseLoc = UserInputService:GetMouseLocation()
			cursorSpeedLabel.Position = UDim2.fromOffset(mouseLoc.X + 15, mouseLoc.Y - 25)
		end

		local connChanged, connEnded
		connChanged = UserInputService.InputChanged:Connect(function(input)
			if bigDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				updateBigVal(input)
			end
		end)

		connEnded = UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				bigDragging = false
				bigSliderOverlay.Visible = false
				cursorSpeedLabel.Visible = false
				setSpeedMinimized(false)
				if connChanged then connChanged:Disconnect() end
				if connEnded then connEnded:Disconnect() end
			end
		end)
	end

	sliderButton.MouseButton1Down:Connect(function()
		isHolding = true
		initialMousePos = UserInputService:GetMouseLocation()
		localDragging = true

		if holdTimer then task.cancel(holdTimer) end
		holdTimer = task.delay(0.5, function()
			if isHolding then
				isHolding = false
				localDragging = false
				activateBigSlider()
			end
		end)
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isHolding = false
			localDragging = false
			if holdTimer then task.cancel(holdTimer) holdTimer = nil end
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if isHolding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local currentPos = UserInputService:GetMouseLocation()
			if (currentPos - initialMousePos).Magnitude > 8 then
				isHolding = false
				if holdTimer then task.cancel(holdTimer) holdTimer = nil end
			end
		end

		if not localDragging then return end
		local isMouseInput = input.UserInputType == Enum.UserInputType.MouseMovement
		local isTouchInput = input.UserInputType == Enum.UserInputType.Touch
		if not isMouseInput and not isTouchInput then return end

		local pointerX = isTouchInput and input.Position.X or UserInputService:GetMouseLocation().X
		local barPosition = bar.AbsolutePosition.X
		local barWidth = bar.AbsoluteSize.X
		if barWidth <= 0 then return end

		local ratio = math.clamp((pointerX - barPosition) / barWidth, 0, 1)
		local minLimit = tonumber(getMinLimit()) or 0
		local maxLimit = tonumber(getMaxLimit()) or minLimit
		local value = minLimit + ratio * (maxLimit - minLimit)

		if labelText == "WalkSpeed" then 
			isWalkSpeedActive = true 
		else
			isAnimSpeedActive = true
		end
		updateValue(value, false)
	end)

	local function isMouseOver(guiObj)
		local mousePos = UserInputService:GetMouseLocation()
		local absPos = guiObj.AbsolutePosition
		local absSize = guiObj.AbsoluteSize
		return mousePos.X >= absPos.X and mousePos.X <= absPos.X + absSize.X and
			mousePos.Y >= absPos.Y and mousePos.Y <= absPos.Y + absSize.Y
	end

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if input.UserInputType == Enum.UserInputType.MouseWheel then
			if isMouseOver(label) or isMouseOver(bar) or isMouseOver(resetBtn) then
				local direction = input.Position.Z > 0 and 1 or -1
				if labelText == "WalkSpeed" then 
					isWalkSpeedActive = true 
				else
					isAnimSpeedActive = true
				end
				updateValue(currentValHolder + direction, false)
			end
		end
	end)

	updateValue(defaultVal, true)
end

