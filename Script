    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 52
    lbl.Text = labelText .. ": " .. string.format("%.1f", currentVal)
    table.insert(managedTextObjects, lbl)

    local defBtn = Instance.new("TextButton", optionsModalFrame)
    defBtn.Size = UDim2.fromOffset(65, 18)
    defBtn.Position = UDim2.fromOffset(295, yPos - 2)
    defBtn.BackgroundColor3 = customUiConfig.textBgColor
    defBtn.TextColor3 = customUiConfig.textColor
    defBtn.Font = Enum.Font.GothamSemibold
    defBtn.TextSize = 10
    defBtn.ZIndex = 52
    defBtn.Text = "Default"
    table.insert(managedTextObjects, defBtn)
    table.insert(managedInteractiveButtons, defBtn)
    local dbCorner = Instance.new("UICorner", defBtn)
    dbCorner.CornerRadius = UDim.new(0, 4)
    addProfessionalStroke(defBtn)

    local bar = Instance.new("Frame", optionsModalFrame)
    bar.Size = UDim2.fromOffset(340, 10)
    bar.Position = UDim2.fromOffset(20, yPos + 18)
    bar.BackgroundColor3 = Color3.fromRGB(24, 24, 30)
    bar.BorderSizePixel = 0
    bar.ZIndex = 52
    local bc = Instance.new("UICorner", bar)
    bc.CornerRadius = UDim.new(1, 0)
    addProfessionalStroke(bar)

    local fill = Instance.new("Frame", bar)
    local initialRatio = math.clamp((currentVal - minVal) / (maxVal - minVal), 0, 1)
    fill.Size = UDim2.new(initialRatio, 0, 1, 0)
    fill.BackgroundColor3 = customUiConfig.sliderColor
    fill.BorderSizePixel = 0
    fill.ZIndex = 53
    table.insert(managedSliders, fill)
    local fc = Instance.new("UICorner", fill)
    fc.CornerRadius = UDim.new(1, 0)

    local btn = Instance.new("TextButton", bar)
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.ZIndex = 54

    local function applyVal(val)
        val = math.clamp(math.round(val * 10) / 10, minVal, maxVal)
        local ratio = math.clamp((val - minVal) / (maxVal - minVal), 0, 1)
        fill.Size = UDim2.new(ratio, 0, 1, 0)
        lbl.Text = labelText .. ": " .. string.format("%.1f", val)
        callback(val)
    end

    defBtn.MouseButton1Click:Connect(function()
        applyVal(defaultVal)
    end)

    local dragging = false
    btn.MouseButton1Down:Connect(function() dragging = true end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        local isMouseInput = input.UserInputType == Enum.UserInputType.MouseMovement
        local isTouchInput = input.UserInputType == Enum.UserInputType.Touch
        if not isMouseInput and not isTouchInput then return end

        local pointerX = isTouchInput and input.Position.X or UserInputService:GetMouseLocation().X
        local barPos = bar.AbsolutePosition.X
        local barSize = bar.AbsoluteSize.X
        if barSize <= 0 then return end

        local ratio = math.clamp((pointerX - barPos) / barSize, 0, 1)
        local val = minVal + ratio * (maxVal - minVal)
        applyVal(val)
    end)
end

