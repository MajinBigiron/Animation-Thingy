local SAVE_FILE_NAME = "AnimOverride_CustomSaves.json"
local saveData = {
    customSaves = {},
    maxWalkSpeedLimit = 100,
    minWalkSpeedLimit = 1,
    maxAnimSpeedLimit = 5.0,
    minAnimSpeedLimit = 0.1,
