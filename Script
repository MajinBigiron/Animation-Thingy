local function applyHipHeight(enable, customAmount)
    if not humanoid then return end
    if enable then
        if not isHipHeightActive then
            originalHipHeight = humanoid.HipHeight
            isHipHeightActive = true
        end
        currentExtraHipHeight = customAmount or 0.2
        humanoid.HipHeight = originalHipHeight + currentExtraHipHeight
    else
        if isHipHeightActive then
            humanoid.HipHeight = originalHipHeight
            isHipHeightActive = false
            currentExtraHipHeight = 0
        end
    end
end

local function detectAntiCheatAndStartLoop()
    if walkSpeedConn then walkSpeedConn:Disconnect() end
    
    isGameAntiCheatActive = false
    pcall(function()
        if humanoid then
            local testVal = humanoid.WalkSpeed + 5
            humanoid.WalkSpeed = testVal
            task.wait(0.05)
            if humanoid.WalkSpeed ~= testVal then
                isGameAntiCheatActive = true
            end
        end
    end)

    if isGameAntiCheatActive then
        pcall(function()
            local mt = getrawmetatable(game)
            if mt then
                setreadonly(mt, false)
                local oldNewIndex = mt.__newindex
                mt.__newindex = newcclosure(function(self, index, value)
                    if isWalkSpeedActive and self == humanoid and index == "WalkSpeed" and value ~= currentWalkSpeed then
                        return oldNewIndex(self, index, currentWalkSpeed)
                    end
                    return oldNewIndex(self, index, value)
                end)
                setreadonly(mt, true)
            end
        end)
    end

    walkSpeedConn = RunService.RenderStepped:Connect(function()
        if humanoid and humanoid.Parent and isWalkSpeedActive then
            if isGameAntiCheatActive then
                if humanoid.WalkSpeed ~= currentWalkSpeed then
                    pcall(function() humanoid.WalkSpeed = currentWalkSpeed end)
                end
            else
                local base = originalWalkSpeed > 0 and originalWalkSpeed or 16
                local target = base + (currentWalkSpeed - 16)
                if math.abs(humanoid.WalkSpeed - target) > 1 then
                    if humanoid.WalkSpeed ~= currentWalkSpeed and humanoid.WalkSpeed ~= base then
                        originalWalkSpeed = humanoid.WalkSpeed
                    end
                end
            end
        end
    end)
end

local function startAnimLoop()
    if eventConn then eventConn:Disconnect() end

    eventConn = animator.AnimationPlayed:Connect(function(t)
        if enabled and track and t ~= track and t ~= tallTrack then
            pcall(function() t:Stop() end)
        end
    end)

    if not globalLoopConn then
        globalLoopConn = RunService.RenderStepped:Connect(function()
            if not animator then return end
            
            for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
                if t ~= tallTrack and t ~= track then
                    pcall(function()
                        t:AdjustSpeed(currentAnimMultiplier)
                    end)
                end
            end
            
            if tallEnabled and tallTrack then
                if not tallTrack.IsPlaying then
                    pcall(function() tallTrack:Play(0.1, 1, 0) end)
                end
                pcall(function()
                    if tallTrack.Length > 0 and tallTrack.TimePosition == 0 then
                        tallTrack.TimePosition = math.min(0.1, tallTrack.Length)
                    end
                    tallTrack:AdjustSpeed(0)
                end)
            end

            if not enabled or not track then return end

            for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
                if t ~= track and t ~= tallTrack and t.IsPlaying then
                    pcall(function() t:Stop() end)
                end
            end
            
            if not track.IsPlaying then
                pcall(function() track:Play(0.1, 1, 1) end)
            end
            
            if rootPart and rootPart.Parent and track.IsPlaying then
                if activeAnimConfig.isPose then
                    pcall(function() track:AdjustSpeed(currentAnimMultiplier) end)
                elseif activeAnimConfig.speedScaled == false then
                    pcall(function() track:AdjustSpeed(currentAnimMultiplier) end)
                else
                    local vel = rootPart.AssemblyLinearVelocity
                    local groundSpeed = Vector3.new(vel.X, 0, vel.Z).Magnitude
                    local speedRatio = groundSpeed / originalWalkSpeed
                    local baseAnimSpeed = math.clamp(speedRatio, MIN_ANIM_SPEED, MAX_ANIM_SPEED)
                    local finalAnimSpeed = baseAnimSpeed * currentAnimMultiplier
                    
                    pcall(function() track:AdjustSpeed(finalAnimSpeed) end)
                end
            end
        end)
    end
end

local function loadAnim(idStr, speedScaled, hipHeightEnabled)
    if not animator then
        say("Error: No Animator found.")
        return false
    end
    
    local id = idStr:match("%d+") 
    if not id then
        say("Error: Invalid animation ID.")
        return false
    end
    
    if track then
        pcall(function() track:Stop() end)
        track:Destroy()
        track = nil
    end

    local a = Instance.new("Animation")
    a.AnimationId = "rbxassetid://" .. id
    
    local ok, t = pcall(function()
        return animator:LoadAnimation(a)
    end)
    
    if not ok or not t then
        say("Engine failed to load. (Private asset or bad ID)")
        return false
    end

    track = t
    track.Priority = HIGH
    track.Looped = true
    
    activeAnimConfig.speedScaled = (speedScaled == true)
    activeAnimConfig.hipHeightEnabled = (hipHeightEnabled == true)
    activeAnimConfig.isPose = false
    
    if not activeAnimConfig.speedScaled then
        task.defer(function()
            if track then pcall(function() track:AdjustSpeed(currentAnimMultiplier) end) end
        end)
    end
    
    if activeAnimConfig.hipHeightEnabled then
        applyHipHeight(true, 0.2)
    else
        applyHipHeight(false)
    end
    
    say("Loaded ID: " .. id)
    return true
end

local function playOneUsePose(idStr)
    if not animator then return end
    local id = idStr:match("%d+")
    if not id then return end

    if track then
        pcall(function() track:Stop(0.1) end)
        track:Destroy()
        track = nil
    end

    local a = Instance.new("Animation")
    a.AnimationId = "rbxassetid://" .. id
    
    local ok, t = pcall(function()
        return animator:LoadAnimation(a)
    end)
    
    if ok and t then
        track = t
        track.Priority = Enum.AnimationPriority.Action4
        track.Looped = true
        track:Play(0.1, 1, currentAnimMultiplier)
        
        activeAnimConfig.isPose = true
        activeAnimConfig.speedScaled = false
        activeAnimConfig.hipHeightEnabled = false
        
        enabled = true
        btn.Text = "Stop"
        startAnimLoop()
        
        say("Applied Custom Animation.")
    else
        say("Failed to play animation.")
    end
end

local function refreshSavesUI()
    -- Clear override buttons
    for _, child in ipairs(scrollOverrides:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    -- Clear pose buttons
    for _, child in ipairs(scrollPoses:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    local overrideCount = 0
    local poseCount = 0
    
    for i, save in ipairs(saveData.customSaves) do
        if save.isOverride then
            overrideCount = overrideCount + 1
            local saveBtnUI = Instance.new("TextButton", scrollOverrides)
            saveBtnUI.Size = UDim2.fromOffset(210, 28)
            saveBtnUI.Position = UDim2.fromOffset(10, (overrideCount - 1) * 32 + 5)
            saveBtnUI.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
            saveBtnUI.TextColor3 = Color3.new(1, 1, 1)
            saveBtnUI.Font = Enum.Font.SourceSans
            saveBtnUI.TextSize = 13
            
            local speedText = (save.speedScaled == false) and " (Fixed)" or ""
            local hipText = (save.hipHeightEnabled) and " [Hip]" or ""
            saveBtnUI.Text = save.name .. speedText .. hipText
            
            local c = Instance.new("UICorner", saveBtnUI)
            c.CornerRadius = UDim.new(0, 4)
            
            saveBtnUI.MouseButton1Click:Connect(function()
                box.Text = save.id
                local sScaled = (save.speedScaled == true)
                local hEnabled = (save.hipHeightEnabled == true)
                
                isSpeedScaled = sScaled
                mSpeedBtn.Text = "Speed Scaled: " .. (isSpeedScaled and "ON" or "OFF")
                
                loadAnim(save.id, sScaled, hEnabled)
                enabled = true
                btn.Text = "Stop"
                startAnimLoop()
                
                say("Loaded override: " .. save.name)
            end)
            
            saveBtnUI.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton2 then
                    table.remove(saveData.customSaves, i)
                    saveSavesToFile()
                    refreshSavesUI()
                    say("Deleted custom animation.")
                end
            end)
        else
            poseCount = poseCount + 1
            local saveBtnUI = Instance.new("TextButton", scrollPoses)
            saveBtnUI.Size = UDim2.fromOffset(210, 28)
            saveBtnUI.Position = UDim2.fromOffset(10, (poseCount - 1) * 32 + 5)
            saveBtnUI.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
            saveBtnUI.TextColor3 = Color3.new(1, 1, 1)
            saveBtnUI.Font = Enum.Font.SourceSans
            saveBtnUI.TextSize = 13
            
            saveBtnUI.Text = save.name .. " (Pose/Dance)"
            
            local c = Instance.new("UICorner", saveBtnUI)
            c.CornerRadius = UDim.new(0, 4)
            
            saveBtnUI.MouseButton1Click:Connect(function()
                box.Text = save.id
                playOneUsePose(save.id)
            end)
            
            saveBtnUI.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton2 then
                    table.remove(saveData.customSaves, i)
                    saveSavesToFile()
                    refreshSavesUI()
                    say("Deleted custom animation.")
                end
            end)
        end
    end
    
    scrollOverrides.CanvasSize = UDim2.new(0, 0, 0, overrideCount * 32)
    scrollPoses.CanvasSize = UDim2.new(0, 0, 0, poseCount * 32)
end

