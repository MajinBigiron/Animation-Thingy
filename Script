local function applyHipHeight(enableExtra)
    if not humanoid then return end
    if enableExtra and not isExtraHipHeightActive then
        originalHipHeight = humanoid.HipHeight
        humanoid.HipHeight = originalHipHeight + 0.2
        isExtraHipHeightActive = true
    elseif not enableExtra and isExtraHipHeightActive then
        humanoid.HipHeight = originalHipHeight
        isExtraHipHeightActive = false
    end
end

stopFullCustomSet = function()
    if activeFullSetConnection then
        activeFullSetConnection:Disconnect()
        activeFullSetConnection = nil
    end
    for _, trk in pairs(activeFullSetTracks) do
        pcall(function() trk:Stop(0.1) trk:Destroy() end)
    end
    activeFullSetTracks = {}
    applyHipHeight(false)
end

local function loadAnim(idStr, speedScaled, isPose, hipHeightEnabled, displayName)
    if not animator then showNotification("Error: No Animator found.") return false end
    stopFullCustomSet()
    local id = idStr:match("%d+") 
    if not id then showNotification("Error: Invalid animation ID.") return false end
    
    applyHipHeight(hipHeightEnabled == true)
    local animLabel = displayName or id

    if isPose then
        if track then pcall(function() track:Stop() end) track:Destroy() track = nil end
        if poseTrack then pcall(function() poseTrack:Stop() end) poseTrack:Destroy() poseTrack = nil end
        
        local a = Instance.new("Animation")
        a.AnimationId = "rbxassetid://" .. id
        local ok, newTrack = pcall(function() return animator:LoadAnimation(a) end)
        a:Destroy()
        if not ok or not newTrack then showNotification("Engine failed to load pose.") return false end
        poseTrack = newTrack
        poseTrack.Priority = HIGH
        poseTrack.Looped = true
        activeAnimConfig.isPose = true
        
        pcall(function() poseTrack:Play(0.1, 1, 1) end)
        showNotification("Playing Pose: " .. animLabel)
        return true
    else
        if poseTrack then pcall(function() poseTrack:Stop() end) poseTrack:Destroy() poseTrack = nil end
        if track then pcall(function() track:Stop() end) track:Destroy() track = nil end
        
        local a = Instance.new("Animation")
        a.AnimationId = "rbxassetid://" .. id
        local ok, newTrack = pcall(function() return animator:LoadAnimation(a) end)
        a:Destroy()
        if not ok or not newTrack then showNotification("Engine failed to load override.") return false end
        
        track = newTrack
        track.Priority = HIGH
        track.Looped = true
        
        activeAnimConfig.speedScaled = (speedScaled == true)
        activeAnimConfig.isPose = false
        showNotification("Loaded Override: " .. animLabel)
        return true
    end
end

local function loadFullCustomSet(saveDataEntry)
    if not animator then showNotification("Error: No Animator found.") return end
    stopFullCustomSet()
    if track then pcall(function() track:Stop() end) track:Destroy() track = nil end
    if poseTrack then pcall(function() poseTrack:Stop() end) poseTrack:Destroy() poseTrack = nil end

    applyHipHeight(saveDataEntry.hipHeightEnabled == true)

    activeFullSetTracks = {}
    local function loadSubTrack(idStr, looped)
        local cleanId = idStr and idStr:match("%d+")
        if not cleanId then return nil end
        local a = Instance.new("Animation")
        a.AnimationId = "rbxassetid://" .. cleanId
        local ok, t = pcall(function() return animator:LoadAnimation(a) end)
        a:Destroy()
        if ok and t then
            t.Priority = HIGH
            t.Looped = (looped ~= false)
            return t
        end
        return nil
    end

    activeFullSetTracks.idle = loadSubTrack(saveDataEntry.idleId, true)
    activeFullSetTracks.idle2 = loadSubTrack(saveDataEntry.idle2Id, true)
    activeFullSetTracks.walk = loadSubTrack(saveDataEntry.walkId, true)
    activeFullSetTracks.run = loadSubTrack(saveDataEntry.runId, true)
    activeFullSetTracks.jump = loadSubTrack(saveDataEntry.jumpId, false)
    activeFullSetTracks.fall = loadSubTrack(saveDataEntry.fallId, true)
    activeFullSetTracks.swim = loadSubTrack(saveDataEntry.swimId, true)
    activeFullSetTracks.swimIdle = loadSubTrack(saveDataEntry.swimIdleId, true)
    activeFullSetTracks.climb = loadSubTrack(saveDataEntry.climbId, true)

    local currentPlayingState = nil
    local idleAltTimer = 0

    activeFullSetConnection = RunService.RenderStepped:Connect(function(dt)
        if not humanoid or not humanoid.Parent then return end
        local vel = rootPart and rootPart.AssemblyLinearVelocity or Vector3.zero
        local groundSpeed = Vector3.new(vel.X, 0, vel.Z).Magnitude
        local state = humanoid:GetState()

        local targetTrack = activeFullSetTracks.idle
        local stateName = "idle"

        if state == Enum.HumanoidStateType.Swimming then
            if groundSpeed <= 0.3 and activeFullSetTracks.swimIdle then
                targetTrack = activeFullSetTracks.swimIdle
                stateName = "swimIdle"
            else
                targetTrack = activeFullSetTracks.swim or activeFullSetTracks.idle
                stateName = "swim"
            end
        elseif state == Enum.HumanoidStateType.Climbing then
            targetTrack = activeFullSetTracks.climb or activeFullSetTracks.idle
            stateName = "climb"
        elseif state == Enum.HumanoidStateType.Jumping then
            targetTrack = activeFullSetTracks.jump or activeFullSetTracks.fall or activeFullSetTracks.idle
            stateName = "jump"
        elseif state == Enum.HumanoidStateType.Freefall then
            targetTrack = activeFullSetTracks.fall or activeFullSetTracks.jump or activeFullSetTracks.idle
            stateName = "fall"
        elseif groundSpeed > 0.3 then
            if groundSpeed > 19 and activeFullSetTracks.run then
                targetTrack = activeFullSetTracks.run
                stateName = "run"
            else
                targetTrack = activeFullSetTracks.walk or activeFullSetTracks.idle
                stateName = "walk"
            end
            idleAltTimer = 0
        else
            if activeFullSetTracks.idle2 then
                idleAltTimer = idleAltTimer + dt
                if idleAltTimer > 7 then
                    targetTrack = activeFullSetTracks.idle2
                    stateName = "idle2"
                    if idleAltTimer > 14 then idleAltTimer = 0 end
                end
            end
        end

        if currentPlayingState ~= stateName then
            for _, trk in pairs(activeFullSetTracks) do
                if trk and trk.IsPlaying then
                    trk:Stop(0.15)
                end
            end
            currentPlayingState = stateName
            if targetTrack then
                targetTrack:Play(0.15)
            end
        end

        if targetTrack and not targetTrack.IsPlaying then
            targetTrack:Play(0.15)
        end
    end)

    showNotification("Loaded Full Set: " .. saveDataEntry.name)
end

