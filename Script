local function createSlider(yPos, labelText, defaultVal, callback, getMinLimit, getMaxLimit)
    local label = Instance.new("TextButton", sliderContainer)
    label.Size = UDim2.fromOffset(170, 18)
    label.Position = UDim2.fromOffset(0, yPos)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.new(1, 1, 1)
    label.Font = Enum.Font.SourceSansBold
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Text = labelText .. ": " .. tostring(defaultVal)
    
    label.MouseButton1Click:Connect(function()
        openSpeedModal(labelText)
    end)
    
    local resetBtn = Instance.new("TextButton", sliderContainer)
    resetBtn.Size = UDim2.fromOffset(50, 18)
    resetBtn.Position = UDim2.fromOffset(180, yPos)
    resetBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    resetBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    resetBtn.Font = Enum.Font.SourceSansSemibold
    resetBtn.TextSize = 11
    resetBtn.Text = "Reset"
    local rc = Instance.new("UICorner", resetBtn)
    rc.CornerRadius = UDim.new(0, 4)
    
    local bar = Instance.new("Frame", sliderContainer)
    bar.Size = UDim2.fromOffset(230, 8)
    bar.Position = UDim2.fromOffset(0, yPos + 22)
    bar.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    bar.BorderSizePixel = 0
    local bc = Instance.new("UICorner", bar)
    bc.CornerRadius = UDim.new(1, 0)
    
    local fill = Instance.new("Frame", bar)
    fill.Size = UDim2.new((defaultVal - getMinLimit()) / (getMaxLimit() - getMinLimit()), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(255, 200, 60)
    fill.BorderSizePixel = 0
    local fc = Instance.new("UICorner", fill)
    fc.CornerRadius = UDim.new(1, 0)
    
    local btn = Instance.new("TextButton", bar)
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    
    local holdTimer = nil
    local currentValHolder = defaultVal
    local isPrecisionActive = false
    local localDragging = false
    local pressPos = Vector2.zero
    local wasPreviouslyMinimized = false
    
    local function cancelHold()
        if holdTimer then
            task.cancel(holdTimer)
            holdTimer = nil
        end
    end
    
    local function updateValue(val, isReset)
        local currentMin = getMinLimit()
        local currentMax = getMaxLimit()
        val = math.clamp(val, currentMin, currentMax)
        
        if currentMax > 100 and not isPrecisionActive then
            val = math.round(val)
        else
            if not isPrecisionActive then
                if currentMax <= 10 then
                    val = math.floor(val * 100 + 0.5) / 100
                else
                    val = math.floor(val * 10 + 0.5) / 10
                end
            else
                if currentMax > 10 then 
                    val = math.floor(val * 10) / 10 
                else 
                    val = math.floor(val * 100) / 100 
                end
            end
        end
        
        currentValHolder = val
        local ratio = (val - currentMin) / (currentMax - currentMin)
        fill.Size = UDim2.new(ratio, 0, 1, 0)
        label.Text = labelText .. ": " .. tostring(val)
        callback(val, isReset)
        
        if isPrecisionActive and precisionOverlay.Visible then
            precisionTitle.Text = labelText .. " (Precision): " .. string.format("%.2f", val)
            screenFill.Size = UDim2.new(ratio, 0, 1, 0)
        end
    end
    
    if labelText == "WalkSpeed" then
        updateWalkSpeedSlider = function(newDefault, isReset)
            updateValue(newDefault, isReset)
        end
    elseif labelText == "Animation Speed" then
        updateAnimSpeedSlider = function(newDefault)
            updateValue(newDefault)
        end
    end
    
    resetBtn.MouseButton1Click:Connect(function()
        cancelHold()
        if isPrecisionActive then
            isPrecisionActive = false
            precisionOverlay.Visible = false
            if not wasPreviouslyMinimized then
                setSpeedMinimized(false)
            end
        end
        if labelText == "WalkSpeed" then
            isWalkSpeedActive = false
            updateValue(originalWalkSpeed, true)
        else
            updateValue(defaultVal, false)
        end
    end)
    
    btn.MouseButton1Down:Connect(function() 
        localDragging = true
        cancelHold()
        pressPos = UserInputService:GetMouseLocation()
        
        holdTimer = task.delay(1.0, function()
            if localDragging then
                local currentPos = UserInputService:GetMouseLocation()
                if (currentPos - pressPos).Magnitude < 5 then
                    isPrecisionActive = true
                    activePrecisionCallback = updateValue
                    activePrecisionMaxGetter = getMaxLimit
                    activePrecisionMinGetter = getMinLimit
                    
                    wasPreviouslyMinimized = isSpeedMinimized
                    if not isSpeedMinimized then
                        setSpeedMinimized(true)
                    end
                    
                    precisionTitle.Text = labelText .. " (Precision): " .. string.format("%.2f", currentValHolder)
                    local ratio = (currentValHolder - getMinLimit()) / (getMaxLimit() - getMinLimit())
                    screenFill.Size = UDim2.new(ratio, 0, 1, 0)
                    precisionOverlay.Visible = true
                end
            end
        end)
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then 
            localDragging = false
            cancelHold()
            if isPrecisionActive then
                isPrecisionActive = false
                precisionOverlay.Visible = false
                if not wasPreviouslyMinimized then
                    setSpeedMinimized(false)
                end
            end
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if localDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local currentPos = UserInputService:GetMouseLocation()
            if not isPrecisionActive and (currentPos - pressPos).Magnitude > 5 then
                cancelHold()
            end
            
            if not isPrecisionActive then
                local mousePos = currentPos.X
                local barPos = bar.AbsolutePosition.X
                local barSize = bar.AbsoluteSize.X
                local ratio = math.clamp((mousePos - barPos) / barSize, 0, 1)
                local currentMin = getMinLimit()
                local currentMax = getMaxLimit()
                local val = currentMin + ratio * (currentMax - currentMin)
                if labelText == "WalkSpeed" then
                    isWalkSpeedActive = true
                end
                updateValue(val, false)
            end
        end
    end)
end

-- Full-screen precision dragging support
UserInputService.InputChanged:Connect(function(input)
    if precisionOverlay.Visible and input.UserInputType == Enum.UserInputType.MouseMovement then
        local mousePos = UserInputService:GetMouseLocation().X
        local barPos = screenBar.AbsolutePosition.X
        local barSize = screenBar.AbsoluteSize.X
        local ratio = math.clamp((mousePos - barPos) / barSize, 0, 1)
        if activePrecisionMaxGetter and activePrecisionMinGetter and activePrecisionCallback then
            local currentMin = activePrecisionMinGetter()
            local currentMax = activePrecisionMaxGetter()
            local val = currentMin + ratio * (currentMax - currentMin)
            activePrecisionCallback(val, false)
        end
    end
end)

