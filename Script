local function createOptInput(yPos, labelText, defaultVal, callback)
    local lbl = Instance.new("TextLabel", optionsFrame)
    lbl.Size = UDim2.fromOffset(120, 20)
    lbl.Position = UDim2.fromOffset(10, yPos)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = Color3.new(1, 1, 1)
    lbl.Font = Enum.Font.SourceSansSemibold
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 51
    lbl.Text = labelText

    local box = Instance.new("TextBox", optionsFrame)
    box.Size = UDim2.fromOffset(80, 22)
    box.Position = UDim2.fromOffset(140, yPos)
    box.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    box.TextColor3 = Color3.new(1, 1, 1)
    box.Font = Enum.Font.SourceSansSemibold
    box.TextSize = 12
    box.Text = tostring(defaultVal)
    box.ClearTextOnFocus = false
    box.ZIndex = 51
    local c = Instance.new("UICorner", box)
    c.CornerRadius = UDim.new(0, 4)

    box.FocusLost:Connect(function()
        local val = tonumber(box.Text)
        if val then
            callback(val)
        else
            box.Text = tostring(defaultVal)
        end
    end)
    return box
end

