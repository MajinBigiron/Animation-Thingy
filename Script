local ragdollConnection = nil

local function setRagdoll(state)
    ragdollEnabled = state
    btnRagdoll.Text = "Ragdoll: " .. (ragdollEnabled and "ON" or "OFF")
    
    if not plr.Character or not humanoid or not rootPart then return end
    local char = plr.Character
    
    if ragdollEnabled then
        humanoid:ChangeState(Enum.HumanoidStateType.Physics)
        for _, desc in ipairs(char:GetDescendants()) do
            if desc:IsA("Motor6D") then
                desc.Enabled = false
            elseif desc:IsA("BasePart") and desc.Name ~= "HumanoidRootPart" then
                pcall(function()
                    desc.CustomPhysicalProperties = PhysicalProperties.new(0.6, 0.3, 0.5, 1, 1)
                end)
            end
        end

        if ragdollConnection then ragdollConnection:Disconnect() end
        ragdollConnection = RunService.RenderStepped:Connect(function()
            if not ragdollEnabled or not rootPart or not rootPart.Parent then 
                if ragdollConnection then ragdollConnection:Disconnect() end
                return 
            end

            local moveDir = humanoid.MoveDirection
            local speed = currentWalkSpeed
            local currentVel = rootPart.AssemblyLinearVelocity

            if moveDir.Magnitude > 0 then
                rootPart.AssemblyLinearVelocity = Vector3.new(moveDir.X * speed, currentVel.Y, moveDir.Z * speed)
            end

            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                if math.abs(currentVel.Y) < 1.0 then
                    rootPart.AssemblyLinearVelocity = Vector3.new(currentVel.X, 50, currentVel.Z)
                end
            end
        end)

        say("Movable & Jumpable Ragdoll enabled.")
    else
        if ragdollConnection then ragdollConnection:Disconnect() end
        for _, desc in ipairs(char:GetDescendants()) do
            if desc:IsA("Motor6D") then
                desc.Enabled = true
            elseif desc:IsA("BasePart") then
                pcall(function()
                    desc.CustomPhysicalProperties = nil
                end)
            end
        end
        humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        say("Ragdoll disabled.")
    end
end

btnRagdoll.MouseButton1Click:Connect(function()
    setRagdoll(not ragdollEnabled)
end)

local function startAnimLoop()
    if not animator then return end
    if eventConn then eventConn:Disconnect(); eventConn = nil end

    eventConn = animator.AnimationPlayed:Connect(function(animationTrack)
        if not enabled then return end
        if animationTrack ~= track and animationTrack ~= poseTrack then 
            if currentAnimMultiplier ~= 1.0 then
                pcall(function() animationTrack:AdjustSpeed(currentAnimMultiplier) end)
            end
        end
    end)

    if globalLoopConn then return end

    globalLoopConn = RunService.RenderStepped:Connect(function(dt)
        if not animator or not animator.Parent then return end

        if isWalkSpeedActive and humanoid and humanoid.Parent then
            if humanoid.WalkSpeed ~= currentWalkSpeed then
                humanoid.WalkSpeed = currentWalkSpeed
            end
        end

        if rootPart and rootPart.Parent then
            local velocity = rootPart.AssemblyLinearVelocity
            local groundSpeed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
            if speedometerLabel and speedometerLabel.Parent then
                speedometerLabel.Text = string.format("Current Speed: %.1f", groundSpeed)
            end
        end

        for _, animationTrack in ipairs(animator:GetPlayingAnimationTracks()) do
            if animationTrack ~= track and animationTrack ~= poseTrack then
                if currentAnimMultiplier ~= 1.0 then
                    pcall(function() animationTrack:AdjustSpeed(currentAnimMultiplier) end)
                end
            end
        end

        if not enabled then return end

        if activeAnimConfig.isPose then
            if poseTrack and not poseTrack.IsPlaying then
                pcall(function() poseTrack:Play(0.1, 1, 1) end)
            end
            pcall(function() poseTrack:AdjustSpeed(currentAnimMultiplier) end)
            return
        end

        if not track then return end
        if not track.IsPlaying then pcall(function() track:Play(0.1, 1, 0) end) end
        if not rootPart or not rootPart.Parent then return end

        local velocity = rootPart.AssemblyLinearVelocity
        local groundSpeed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude

        if groundSpeed < 0.3 then
            pcall(function()
                local char = plr.Character
                if char then
                    local leftFoot = char:FindFirstChild("LeftFoot") or char:FindFirstChild("Left Leg")
                    local rightFoot = char:FindFirstChild("RightFoot") or char:FindFirstChild("Right Leg")
                    local leftHand = char:FindFirstChild("LeftHand") or char:FindFirstChild("Left Arm")
                    local rightHand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
                    
                    local raycastParams = RaycastParams.new()
                    raycastParams.FilterDescendantsInstances = {char}
                    raycastParams.FilterType = Enum.RaycastFilterType.Exclude

                    local limbsOnGround = 0
                    local totalLimbsChecked = 0

                    for _, limb in ipairs({leftFoot, rightFoot, leftHand, rightHand}) do
                        if limb and limb:IsA("BasePart") then
                            totalLimbsChecked = totalLimbsChecked + 1
                            local ray = workspace:Raycast(limb.Position, Vector3.new(0, -2.5, 0), raycastParams)
                            if ray then
                                limbsOnGround = limbsOnGround + 1
                            end
                        end
                    end

                    if totalLimbsChecked > 0 and (limbsOnGround / totalLimbsChecked) >= 0.5 then
                        local targetPosition = math.min(STATIONARY_REST_TIME, math.max(track.Length - 0.001, 0))
                        track.TimePosition += (targetPosition - track.TimePosition) * math.clamp(dt * 10, 0, 1)
                        track:AdjustSpeed(currentAnimMultiplier * 0.1)
                        return
                    end
                end

                local targetPosition = math.min(STATIONARY_REST_TIME, math.max(track.Length - 0.001, 0))
                track.TimePosition += (targetPosition - track.TimePosition) * math.clamp(dt * 5, 0, 1)
                track:AdjustSpeed(currentAnimMultiplier * 0.5)
            end)
        else
            local animationSpeed
            if activeAnimConfig.speedScaled then
                local baseWalkSpeed = math.max(originalWalkSpeed, 0.001)
                animationSpeed = math.clamp((groundSpeed / baseWalkSpeed) * currentAnimMultiplier, MIN_ANIM_SPEED, MAX_ANIM_SPEED)
            else
                animationSpeed = math.clamp(currentAnimMultiplier, MIN_ANIM_SPEED, MAX_ANIM_SPEED)
            end

            pcall(function() track:AdjustSpeed(animationSpeed) end)
        end
    end)
end

refreshSavesUI = function()
