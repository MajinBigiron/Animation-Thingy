local function detectAntiCheatAndStartLoop()
    if walkSpeedConn then walkSpeedConn:Disconnect() end
    
    isGameAntiCheatActive = false
    pcall(function()
        if humanoid then
            local originalTestVal = humanoid.WalkSpeed
            local testVal = originalTestVal + 5
            humanoid.WalkSpeed = testVal
            task.wait(0.05)
            if humanoid.WalkSpeed ~= testVal then
                isGameAntiCheatActive = true
            end
            humanoid.WalkSpeed = originalTestVal
        end
    end)

    if isGameAntiCheatActive then
        pcall(function()
            local mt = getrawmetatable(game)
            if mt then
                setreadonly(mt, false)
                local oldNewIndex = mt.__newindex
                mt.__newindex = newcclosure(function(self, index, value)
                    if isWalkSpeedActive and self == humanoid and index == "WalkSpeed" and value ~= currentWalkSpeed then
                        return oldNewIndex(self, index, currentWalkSpeed)
                    end
                    return oldNewIndex(self, index, value)
                end)
                setreadonly(mt, true)
            end
        end)
    end

    walkSpeedConn = RunService.RenderStepped:Connect(function()
        if humanoid and humanoid.Parent then
            local currentVel = rootPart and rootPart.AssemblyLinearVelocity or Vector3.zero
            local currentGroundSpeed = Vector3.new(currentVel.X, 0, currentVel.Z).Magnitude
            speedometerLabel.Text = string.format("Current Speed: %.1f", currentGroundSpeed)
            
            if isWalkSpeedActive then
                if isGameAntiCheatActive then
                    if humanoid.WalkSpeed ~= currentWalkSpeed then
                        pcall(function() humanoid.WalkSpeed = currentWalkSpeed end)
                    end
                else
                    local base = originalWalkSpeed > 0 and originalWalkSpeed or 16
                    local target = base + (currentWalkSpeed - 16)
                    if math.abs(humanoid.WalkSpeed - target) > 1 then
                        if humanoid.WalkSpeed ~= currentWalkSpeed and humanoid.WalkSpeed ~= base then
                            originalWalkSpeed = humanoid.WalkSpeed
                        end
                    end
                    if humanoid.WalkSpeed ~= target then
                        pcall(function() humanoid.WalkSpeed = target end)
                    end
                end
            end
        end
    end)
end

local function getAnimationSpeed(groundSpeed)
    if activeAnimConfig.isPose or activeAnimConfig.speedScaled == false then
        return currentAnimMultiplier
    end

    local baseWalkSpeed = math.max(originalWalkSpeed, 0.001)
    local speedRatio = groundSpeed / baseWalkSpeed
    local baseAnimationSpeed = math.clamp(
        speedRatio,
        MIN_ANIM_SPEED,
        MAX_ANIM_SPEED
    )

    return math.clamp(
        baseAnimationSpeed * currentAnimMultiplier,
        MIN_ANIM_SPEED,
        MAX_ANIM_SPEED
    )
end

local function ensureTrackPlaying(animationTrack)
    if not animationTrack or animationTrack.IsPlaying then
        return
    end

    pcall(function()
        animationTrack:Play(0.1, 1, 0)
    end)
end

local function freezePoseTrack(animationTrack)
    if not animationTrack then
        return
    end

    ensureTrackPlaying(animationTrack)

    pcall(function()
        if animationTrack.Length > 0 then
            animationTrack.TimePosition = math.min(
                STATIONARY_REST_TIME,
                math.max(animationTrack.Length - 0.001, 0)
            )
        end

        animationTrack:AdjustSpeed(0)
    end)
end

local function startAnimLoop()
    if not animator then
        return
    end

    if eventConn then
        eventConn:Disconnect()
        eventConn = nil
    end

    eventConn = animator.AnimationPlayed:Connect(function(animationTrack)
        if not enabled then
            return
        end

        if animationTrack ~= track
            and animationTrack ~= tallTrack
            and animationTrack ~= shortTrack then

            pcall(function()
                animationTrack:Stop()
            end)
        end
    end)

    if globalLoopConn then
        return
    end

    globalLoopConn = RunService.RenderStepped:Connect(function(dt)
        if not animator or not animator.Parent then
            return
        end

        for _, animationTrack in ipairs(animator:GetPlayingAnimationTracks()) do
            if animationTrack ~= track
                and animationTrack ~= tallTrack
                and animationTrack ~= shortTrack then

                pcall(function()
                    animationTrack:AdjustSpeed(currentAnimMultiplier)
                end)
            end
        end

        if tallEnabled and tallTrack then
            freezePoseTrack(tallTrack)
        end

        if shortEnabled and shortTrack then
            freezePoseTrack(shortTrack)
        end

        if not enabled or not track then
            return
        end

        for _, animationTrack in ipairs(animator:GetPlayingAnimationTracks()) do
            if animationTrack ~= track
                and animationTrack ~= tallTrack
                and animationTrack ~= shortTrack
                and animationTrack.IsPlaying then

                pcall(function()
                    animationTrack:Stop()
                end)
            end
        end

        ensureTrackPlaying(track)

        if not rootPart or not rootPart.Parent or not track.IsPlaying then
            return
        end

        local velocity = rootPart.AssemblyLinearVelocity
        local groundSpeed = Vector3.new(
            velocity.X,
            0,
            velocity.Z
        ).Magnitude

        if not activeAnimConfig.isPose and groundSpeed < 0.1 then
            pcall(function()
                local targetPosition = math.min(
                    STATIONARY_REST_TIME,
                    math.max(track.Length - 0.001, 0)
                )

                track.TimePosition += (
                    targetPosition - track.TimePosition
                ) * math.clamp(dt * 10, 0, 1)

                track:AdjustSpeed(0)
            end)
        else
            local animationSpeed = getAnimationSpeed(groundSpeed)

            pcall(function()
                track:AdjustSpeed(animationSpeed)
            end)
        end
    end)
end

local function loadAnim(idStr, speedScaled, hipHeightEnabled)
    if not animator then
        say("Error: No Animator found.")
        return false
    end
    
    local id = idStr:match("%d+") 
    if not id then
        say("Error: Invalid animation ID.")
        return false
    end
    
    if track then
        pcall(function() track:Stop() end)
        track:Destroy()
        track = nil
    end

    local a = Instance.new("Animation")
    a.AnimationId = "rbxassetid://" .. id
    
    local ok, newTrack = pcall(function()
        return animator:LoadAnimation(a)
    end)
    
    a:Destroy()

    if not ok or not newTrack then
        say("Engine failed to load. (Private asset or bad ID)")
        return false
    end

    track = newTrack
    track.Priority = HIGH
    track.Looped = true
    
    activeAnimConfig.speedScaled = (speedScaled == true)
    activeAnimConfig.hipHeightEnabled = (hipHeightEnabled == true)
    activeAnimConfig.isPose = false
    
    if not activeAnimConfig.speedScaled then
        task.defer(function()
            if track then pcall(function() track:AdjustSpeed(currentAnimMultiplier) end) end
        end)
    end
    
    if activeAnimConfig.hipHeightEnabled then
        applyHipHeight(true, 0.2)
    else
        applyHipHeight(false)
    end
    
    say("Loaded ID: " .. id)
    return true
end

local function playOneUsePose(idStr)
    if not animator then return end
    local id = idStr:match("%d+")
    if not id then return end

    if track then
        pcall(function() track:Stop(0.1) end)
        track:Destroy()
        track = nil
    end

    local a = Instance.new("Animation")
    a.AnimationId = "rbxassetid://" .. id
    
    local ok, newTrack = pcall(function()
        return animator:LoadAnimation(a)
    end)
    
    a:Destroy()

    if ok and newTrack then
        track = newTrack
        track.Priority = Enum.AnimationPriority.Action4
        track.Looped = true
        track:Play(0.1, 1, currentAnimMultiplier)
        
        activeAnimConfig.isPose = true
        activeAnimConfig.speedScaled = false
        activeAnimConfig.hipHeightEnabled = false
        
        enabled = true
        btn.Text = "Stop"
        startAnimLoop()
        
        say("Applied Custom Animation.")
    else
        say("Failed to play animation.")
    end
end

function refreshSavesUI()
    for _, child in ipairs(scrollOverrides:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    for _, child in ipairs(scrollPoses:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    local overrideCount = 0
    local poseCount = 0
    local query = string.lower(searchBox.Text)
    
    for i, save in ipairs(saveData.customSaves) do
        local nameLower = string.lower(save.name)
        local matchesSearch = (query == "" or string.find(nameLower, query, 1, true) ~= nil)
        
        if matchesSearch then
            if save.isOverride then
                overrideCount = overrideCount + 1
                local saveBtnUI = Instance.new("TextButton", scrollOverrides)
                saveBtnUI.Size = UDim2.fromOffset(210, 28)
                saveBtnUI.Position = UDim2.fromOffset(10, (overrideCount - 1) * 32 + 5)
                saveBtnUI.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
                saveBtnUI.TextColor3 = Color3.new(1, 1, 1)
                saveBtnUI.Font = Enum.Font.SourceSans
                saveBtnUI.TextSize = customUiConfig.textSize
                table.insert(managedTextObjects, saveBtnUI)
                
                local speedText = (save.speedScaled == false) and " (Fixed)" or ""
                local hipText = (save.hipHeightEnabled) and " [Hip]" or ""
                saveBtnUI.Text = save.name .. speedText .. hipText
                
                local c = Instance.new("UICorner", saveBtnUI)
                c.CornerRadius = UDim.new(0, 4)
                
                saveBtnUI.MouseButton1Click:Connect(function()
                    box.Text = save.id
                    local sScaled = (save.speedScaled == true)
                    local hEnabled = (save.hipHeightEnabled == true)
                    
                    isSpeedScaled = sScaled
                    mSpeedBtn.Text = "Speed Scaled: " .. (isSpeedScaled and "ON" or "OFF")
                    
                    loadAnim(save.id, sScaled, hEnabled)
                    enabled = true
                    btn.Text = "Stop"
                    startAnimLoop()
                    
                    say("Loaded override: " .. save.name)
                end)
                
                saveBtnUI.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton2 then
                        openDeleteModal(i, save.name)
                    end
                end)
            else
                poseCount = poseCount + 1
                local saveBtnUI = Instance.new("TextButton", scrollPoses)
                saveBtnUI.Size = UDim2.fromOffset(210, 28)
                saveBtnUI.Position = UDim2.fromOffset(10, (poseCount - 1) * 32 + 5)
                saveBtnUI.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
                saveBtnUI.TextColor3 = Color3.new(1, 1, 1)
                saveBtnUI.Font = Enum.Font.SourceSans
                saveBtnUI.TextSize = customUiConfig.textSize
                table.insert(managedTextObjects, saveBtnUI)
                
                saveBtnUI.Text = save.name .. " (Pose/Dance)"
                
                local c = Instance.new("UICorner", saveBtnUI)
                c.CornerRadius = UDim.new(0, 4)
                
                saveBtnUI.MouseButton1Click:Connect(function()
                    box.Text = save.id
                    playOneUsePose(save.id)
                end)
                
                saveBtnUI.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton2 then
                        openDeleteModal(i, save.name)
                    end
                end)
            end
        end
    end
    
    scrollOverrides.CanvasSize = UDim2.new(0, 0, 0, overrideCount * 32)
    scrollPoses.CanvasSize = UDim2.new(0, 0, 0, poseCount * 32)
end

