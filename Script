local function loadAnim(idStr, speedScaled, isPose)
    if not animator then say("Error: No Animator found.") return false end
    local id = idStr:match("%d+") 
    if not id then say("Error: Invalid animation ID.") return false end
    
    if isPose then
        if track then pcall(function() track:Stop() end) track:Destroy() track = nil end
        if poseTrack then pcall(function() poseTrack:Stop() end) poseTrack:Destroy() poseTrack = nil end
        
        local a = Instance.new("Animation")
        a.AnimationId = "rbxassetid://" .. id
        local ok, newTrack = pcall(function() return animator:LoadAnimation(a) end)
        a:Destroy()
        if not ok or not newTrack then say("Engine failed to load pose.") return false end
        poseTrack = newTrack
        poseTrack.Priority = HIGH
        poseTrack.Looped = true
        activeAnimConfig.isPose = true
        
        pcall(function()
            for _, descendant in ipairs(poseTrack:GetTracks()) do
                local name = string.lower(descendant.Name)
                if name:find("uppertorso") or name:find("head") or name:find("torso") then
                    descendant:AdjustWeight(0)
                end
            end
        end)

        pcall(function() poseTrack:Play(0.1, 1, 1) end)
        say("Playing Pose ID: " .. id)
        return true
    else
        if poseTrack then pcall(function() poseTrack:Stop() end) poseTrack:Destroy() poseTrack = nil end
        if track then pcall(function() track:Stop() end) track:Destroy() track = nil end
        
        local a = Instance.new("Animation")
        a.AnimationId = "rbxassetid://" .. id
        local ok, newTrack = pcall(function() return animator:LoadAnimation(a) end)
        a:Destroy()
        if not ok or not newTrack then say("Engine failed to load override.") return false end
        
        track = newTrack
        track.Priority = HIGH
        track.Looped = true
        
        pcall(function()
            for _, descendant in ipairs(track:GetTracks()) do
                local name = string.lower(descendant.Name)
                if name:find("uppertorso") or name:find("head") or name:find("torso") then
                    descendant:AdjustWeight(0)
                end
            end
        end)
        
        activeAnimConfig.speedScaled = (speedScaled == true)
        activeAnimConfig.isPose = false
        say("Loaded Override ID: " .. id)
        return true
    end
end

