    local function bind(char)
        humanoid = char:WaitForChild("Humanoid", 5)
        if not humanoid then return end

        originalWalkSpeed = 16
        currentWalkSpeed = originalWalkSpeed
        isWalkSpeedActive = false
        originalHipHeight = humanoid.HipHeight
        isExtraHipHeightActive = false

        if walkSpeedConn then walkSpeedConn:Disconnect() end
        walkSpeedConn = humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
            if isWalkSpeedActive and humanoid.WalkSpeed ~= currentWalkSpeed then
                humanoid.WalkSpeed = currentWalkSpeed
            end
        end)

        rootPart = char:WaitForChild("HumanoidRootPart", 5)
        animator = humanoid:WaitForChild("Animator", 5)

        track = nil
        poseTrack = nil
        tallEnabled = false btnTall.Text = "Tall: OFF"
        shortEnabled = false btnShort.Text = "Short: OFF"
        ragdollEnabled = false btnRagdoll.Text = "Ragdoll: OFF"
        btnToggleSaves.Text = "Custom Saves: OFF"
        startAnimLoop()
    end

    btn.MouseButton1Click:Connect(function()
        if not enabled then
            if not track and not poseTrack and not activeFullSetConnection and box.Text ~= "" then loadAnim(box.Text, isSpeedScaled, false, isHipHeightEnabled, "Manual ID") end
            if not track and not poseTrack and not activeFullSetConnection then showNotification("Load an animation first.") return end
        end
        enabled = not enabled
        btn.Text = enabled and "Stop" or "Play"
        if enabled then 
            tallEnabled = false btnTall.Text = "Tall: OFF"
            shortEnabled = false btnShort.Text = "Short: OFF"
            startAnimLoop()
            showNotification("Animation Started")
        else
            if track then pcall(function() track:Stop(0.1) track:Destroy() end) track = nil end
            if poseTrack then pcall(function() poseTrack:Stop(0.1) poseTrack:Destroy() end) poseTrack = nil end
            
            stopFullCustomSet()

            if animator then
                for _, animTrack in ipairs(animator:GetPlayingAnimationTracks()) do
                    pcall(function() animTrack:Stop(0.1) end)
                end
            end

            if eventConn then eventConn:Disconnect(); eventConn = nil end
            applyHipHeight(false)
            box.Text = ""
            showNotification("All Animations Stopped")
        end
    end)

    btnToggleSaves.MouseButton1Click:Connect(function()
        local isOpen = not savesFrame.Visible
        btnToggleSaves.Text = "Custom Saves: " .. (isOpen and "ON" or "OFF")
        local targetPos = UDim2.new(1, -20, 0.5, -90)

        if isOpen then
            savesFrame.Visible = true
            savesFrame.Position = UDim2.new(1, -20, 0, -380)
            savesFrame.Rotation = 180
            
            pcall(function()
                local s = Instance.new("Sound")
                s.SoundId = "rbxassetid://87437544236708"
                s.Volume = 1
                s.Parent = SoundService
                s:Play()
                s.Ended:Connect(function() s:Destroy() end)
            end)
            
            TweenService:Create(savesFrame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Position = targetPos,
                Rotation = 0
            }):Play()
        else
            local tween = TweenService:Create(savesFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Position = UDim2.new(1, -20, 0, -380),
                Rotation = 0
            })
            tween:Play()
            tween.Completed:Connect(function()
                if not savesFrame.Visible then return end
                if savesFrame.Position.Y.Offset < 0 then
                    savesFrame.Visible = false
                    savesFrame.Position = targetPos
                end
            end)
        end
    end)

