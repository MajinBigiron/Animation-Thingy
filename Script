local function updateLimitPair(minValue, maxValue, currentMin, currentMax, minimumAllowed)
    local newMin = tonumber(minValue)
    local newMax = tonumber(maxValue)

    if newMin == nil then
        newMin = currentMin
    end

    if newMax == nil then
        newMax = currentMax
    end

    newMin = math.max(minimumAllowed, newMin)
    newMax = math.max(newMin, newMax)

    return newMin, newMax
end

