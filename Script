local function createSlider(
    yPos,
    labelText,
    defaultVal,
    callback,
    getMinLimit,
    getMaxLimit
)
    local label = Instance.new("TextButton")
    label.Name = labelText .. "Label"
    label.Size = UDim2.fromOffset(170, 18)
