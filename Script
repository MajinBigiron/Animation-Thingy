local function createOptionSlider(yPos, labelText, minVal, maxVal, defaultVal, currentVal, callback)
    local lbl = Instance.new("TextLabel", optionsModalFrame)
    lbl.Size = UDim2.fromOffset(260, 16)
    lbl.Position = UDim2.fromOffset(20, yPos)
    lbl.BackgroundTransparency = 1
