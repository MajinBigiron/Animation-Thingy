    local wheelDragging = false
    local function updateWheelFromMouse()
        local mousePos = UserInputService:GetMouseLocation()
        local absPos = wheelContainer.AbsolutePosition
        local absSize = wheelContainer.AbsoluteSize
        local center = absPos + absSize / 2
        local offset = mousePos - center
        local dist = offset.Magnitude
        local maxRad = absSize.X / 2

        local clampedOffset = offset
        if dist > maxRad then clampedOffset = offset.Unit * maxRad end

        currentSat = math.clamp(clampedOffset.Magnitude / maxRad, 0, 1)
        currentHue = (math.atan2(-clampedOffset.Y, clampedOffset.X) / math.pi + 1) / 2

        crosshair.Position = UDim2.new(0.5, clampedOffset.X, 0.5, clampedOffset.Y)
        updateValGradient()
        applyPickedColor(Color3.fromHSV(currentHue, currentSat, currentVal))
    end

