local function normaliseLimits()
    minWalkSpeedLimit = math.max(0, tonumber(minWalkSpeedLimit) or 1)
    maxWalkSpeedLimit = math.max(minWalkSpeedLimit, tonumber(maxWalkSpeedLimit) or 100)
    minAnimSpeedLimit = math.max(MIN_ANIM_SPEED, tonumber(minAnimSpeedLimit) or 0.1)
    maxAnimSpeedLimit = math.max(minAnimSpeedLimit, tonumber(maxAnimSpeedLimit) or MAX_ANIM_SPEED)
end

local function loadSavesFromFile()
    pcall(function()
        if readfile and isfile and isfile(SAVE_FILE_NAME) then
            local content = readfile(SAVE_FILE_NAME)
            local decoded = HttpService:JSONDecode(content)
            if type(decoded) ~= "table" then return end

            if type(decoded.customSaves) == "table" then
                saveData.customSaves = decoded.customSaves
            else
                saveData.customSaves = decoded
            end

            if type(decoded.uiSaveSlots) == "table" then
                saveData.uiSaveSlots = decoded.uiSaveSlots
            end

            if decoded.maxWalkSpeedLimit ~= nil then maxWalkSpeedLimit = tonumber(decoded.maxWalkSpeedLimit) or maxWalkSpeedLimit end
            if decoded.minWalkSpeedLimit ~= nil then minWalkSpeedLimit = tonumber(decoded.minWalkSpeedLimit) or minWalkSpeedLimit end
            if decoded.maxAnimSpeedLimit ~= nil then maxAnimSpeedLimit = tonumber(decoded.maxAnimSpeedLimit) or maxAnimSpeedLimit end
            if decoded.minAnimSpeedLimit ~= nil then minAnimSpeedLimit = tonumber(decoded.minAnimSpeedLimit) or minAnimSpeedLimit end
            
            if decoded.uiConfig then
                customUiConfig.height = decoded.uiConfig.height or 360
                customUiConfig.textSize = decoded.uiConfig.textSize or 14
                
                local bgR = decoded.uiConfig.bgR or 16
                local bgG = decoded.uiConfig.bgG or 16
                local bgB = decoded.uiConfig.bgB or 19
                customUiConfig.bgColor = Color3.fromRGB(bgR, bgG, bgB)

                local textR = decoded.uiConfig.textR or 240
                local textG = decoded.uiConfig.textG or 240
                local textB = decoded.uiConfig.textB or 245
                customUiConfig.textColor = Color3.fromRGB(textR, textG, textB)
                
                local textBgR = decoded.uiConfig.textBgR or 24
                local textBgG = decoded.uiConfig.textBgG or 24
                local textBgB = decoded.uiConfig.textBgB or 28
                customUiConfig.textBgColor = Color3.fromRGB(textBgR, textBgG, textBgB)

                local sliderR = decoded.uiConfig.sliderR or 120
                local sliderG = decoded.uiConfig.sliderG or 180
                local sliderB = decoded.uiConfig.sliderB or 255
                customUiConfig.sliderColor = Color3.fromRGB(sliderR, sliderG, sliderB)
                
                customUiConfig.bgTransparency = decoded.uiConfig.bgTransparency or 0.03
            end
        end
    end)
    normaliseLimits()
end

local function saveSavesToFile()
    pcall(function()
        if writefile then
            saveData.maxWalkSpeedLimit = maxWalkSpeedLimit
            saveData.minWalkSpeedLimit = minWalkSpeedLimit
            saveData.maxAnimSpeedLimit = maxAnimSpeedLimit
            saveData.minAnimSpeedLimit = minAnimSpeedLimit
            saveData.uiConfig = {
                height = customUiConfig.height,
                textSize = customUiConfig.textSize,
                bgR = math.floor(customUiConfig.bgColor.R * 255 + 0.5),
                bgG = math.floor(customUiConfig.bgColor.G * 255 + 0.5),
                bgB = math.floor(customUiConfig.bgColor.B * 255 + 0.5),
                textR = math.floor(customUiConfig.textColor.R * 255 + 0.5),
                textG = math.floor(customUiConfig.textColor.G * 255 + 0.5),
                textB = math.floor(customUiConfig.textColor.B * 255 + 0.5),
                textBgR = math.floor(customUiConfig.textBgColor.R * 255 + 0.5),
                textBgG = math.floor(customUiConfig.textBgColor.G * 255 + 0.5),
                textBgB = math.floor(customUiConfig.textBgColor.B * 255 + 0.5),
                sliderR = math.floor(customUiConfig.sliderColor.R * 255 + 0.5),
                sliderG = math.floor(customUiConfig.sliderColor.G * 255 + 0.5),
                sliderB = math.floor(customUiConfig.sliderColor.B * 255 + 0.5),
                bgTransparency = customUiConfig.bgTransparency
            }
            writefile(SAVE_FILE_NAME, HttpService:JSONEncode(saveData))
        end
    end)
end

