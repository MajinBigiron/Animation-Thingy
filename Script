local function applyTallPose()
    if not animator then return end
    if tallTrack then
        pcall(function() tallTrack:Stop() end)
        tallTrack:Destroy()
        tallTrack = nil
    end

    local a = Instance.new("Animation")
    a.AnimationId = "rbxassetid://" .. 92807081069528
    
    local ok, t = pcall(function()
        return animator:LoadAnimation(a)
    end)
    
    if ok and t then
        tallTrack = t
        tallTrack.Priority = Enum.AnimationPriority.Action4 
        tallTrack.Looped = true
        tallTrack:Play(0.1, 1, 1)
        
        task.delay(0.1, function()
            if tallTrack and tallEnabled then
                if tallTrack.Length > 0 then
                    tallTrack.TimePosition = math.min(0.1, tallTrack.Length)
                end
                tallTrack:AdjustSpeed(0)
            end
        end)
        
        if not globalLoopConn then startAnimLoop() end
        say("Tall: ON")
    else
        tallEnabled = false
        btnTall.Text = "Tall: OFF"
    end
end

local function removeTallPose()
    if tallTrack then
        pcall(function() tallTrack:Stop() end)
        tallTrack:Destroy()
        tallTrack = nil
    end
    say("Tall: OFF")
    if not enabled and globalLoopConn and not tallEnabled then
        globalLoopConn:Disconnect()
        globalLoopConn = nil
    end
end

local function bind(char)
    humanoid = char:WaitForChild("Humanoid", 5)
    if not humanoid then return end
    
    originalWalkSpeed = humanoid.WalkSpeed
    currentWalkSpeed = originalWalkSpeed
    isWalkSpeedActive = false
    originalHipHeight = humanoid.HipHeight
    isHipHeightActive = false
    currentExtraHipHeight = 0
    
    if updateWalkSpeedSlider then
        updateWalkSpeedSlider(originalWalkSpeed, true)
    end
    
    rootPart = char:WaitForChild("HumanoidRootPart", 5)
    animator = humanoid:WaitForChild("Animator", 5)
    track = nil
    tallTrack = nil
    tallEnabled = false
    btnTall.Text = "Tall: OFF"
    
    detectAntiCheatAndStartLoop()
    startAnimLoop()
end

