local function mk(parent, cls, y, h, text)
    local o = Instance.new(cls, parent)
    o.Size = UDim2.fromOffset(230, h)
    o.Position = UDim2.fromOffset(10, y)
    o.BackgroundColor3 = customUiConfig.textBgColor
    o.TextColor3 = customUiConfig.textColor
    o.Font = Enum.Font.GothamSemibold
    o.TextSize = customUiConfig.textSize
    if text then o.Text = text end
    
    local corner = Instance.new("UICorner", o)
    corner.CornerRadius = UDim.new(0, 6)
    addProfessionalStroke(o)
    
    table.insert(managedTextObjects, o)
    table.insert(managedInteractiveButtons, o)
    return o
end

local function mkModal(parent, cls, x, y, w, h, text)
    local o = Instance.new(cls)
    o.Size = UDim2.fromOffset(w, h)
    o.Position = UDim2.fromOffset(x, y)
    o.BackgroundColor3 = customUiConfig.textBgColor
    o.TextColor3 = customUiConfig.textColor
    o.Font = Enum.Font.GothamSemibold
    o.TextSize = customUiConfig.textSize

    if parent == modalFrame then
        o.ZIndex = 12
    elseif parent == deleteModalFrame then
        o.ZIndex = 42
    elseif parent == limitModalFrame then
        o.ZIndex = 72
    else
        o.ZIndex = 22
    end

    if text then o.Text = text end
    o.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = o

    addProfessionalStroke(o)
    table.insert(managedTextObjects, o)
    table.insert(managedInteractiveButtons, o)
    return o
end

